+function files(path = home): Array<{ path: string; bytes: string; modified: number }> {
+  return readdirSync(path, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name)).flatMap(entry => {
+    const child = join(path, entry.name);
