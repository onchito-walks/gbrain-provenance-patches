+import { describe, expect, test } from 'bun:test';
+import { createOpenAICompatible } from '@ai-sdk/openai-compatible';
+import { generateText } from 'ai';
+import { applyResolveAuth, opencodeGoSessionHeaders } from '../../src/core/ai/gateway.ts';
+import { getRecipe } from '../../src/core/ai/recipes/index.ts';
+import type { AIGatewayConfig } from '../../src/core/ai/types.ts';
+
+function config(id: string, url: string, session?: string): AIGatewayConfig {
+  return { base_urls: { [id]: url }, env: { DEEPSEEK_API_KEY: 'fixture', LITELLM_API_KEY: 'fixture', OPENCODE_GO_SESSION: session, HOSTNAME: 'fixture-host' }, chat_model: 'deepseek:fixture' } as AIGatewayConfig;
+}
+
+describe('OpenCode GO unified auth', () => {
+  test.each(['deepseek', 'litellm'])('%s sends session through real SDK transport for each touchpoint', async id => {
+    const recipe = getRecipe(id)!;
+    const cfg = config(id, 'https://opencode.ai/zen/go/v1', ' deployment-fixture ');
+    for (const touchpoint of ['embedding', 'expansion', 'chat', 'reranker'] as const) {
+      const auth = applyResolveAuth(recipe, cfg, touchpoint);
+      let captured: Headers | undefined;
+      const provider = createOpenAICompatible({ name: id, baseURL: cfg.base_urls![id]!, ...auth,
+        fetch: (async (_url: RequestInfo | URL, init?: RequestInit) => {
+          captured = new Headers(init?.headers);
+          return new Response(JSON.stringify({ id: 'fixture', object: 'chat.completion', created: 1, model: 'fixture', choices: [{ index: 0, message: { role: 'assistant', content: 'fixture response' }, finish_reason: 'stop' }], usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 } }), { headers: { 'content-type': 'application/json' } });
+        }) as typeof fetch });
+      await generateText({ model: provider.chatModel('fixture'), prompt: 'fixture', maxRetries: 0 });
+      expect(captured!.get('x-opencode-session')).toBe('deployment-fixture');
+      expect(captured!.get('authorization')).toBe('Bearer fixture');
+    }
+  });
+  test.each(['https://api.deepseek.com/v1', 'http://localhost:4000/v1', 'https://opencode.ai.example/v1', 'invalid'])('no header for %s', url => {
+    expect(opencodeGoSessionHeaders(getRecipe('deepseek')!, config('deepseek', url))).toBeUndefined();
+  });
+  test('recipe scope, stable fallback, and subdomain', () => {
+    expect(opencodeGoSessionHeaders(getRecipe('groq')!, config('groq', 'https://opencode.ai/v1'))).toBeUndefined();
+    expect(opencodeGoSessionHeaders(getRecipe('deepseek')!, config('deepseek', 'https://api.opencode.ai/v1', '   '))).toEqual({ 'x-opencode-session': 'gbrain-go-session:fixture-host' });
+  });
+  test('default headers preserved and auth shadow still refused', () => {
+    const recipe = { ...getRecipe('deepseek')!, default_headers: { 'x-fixture': 'yes' } };
+    const cfg = config('deepseek', 'https://opencode.ai/v1');
+    expect(applyResolveAuth(recipe, cfg, 'chat').headers?.['x-fixture']).toBe('yes');
+    expect(() => applyResolveAuth({ ...recipe, default_headers: { Authorization: 'shadow' } }, cfg, 'chat')).toThrow('shadow');
+  });
+});
diff --git a/test/atom-disposition-cache-hit.serial.test.ts b/test/atom-disposition-cache-hit.serial.test.ts
new file mode 100644
index 0000000000..8e201afbc8
--- /dev/null
+++ b/test/atom-disposition-cache-hit.serial.test.ts
@@ -0,0 +1,174 @@
+/**
+ * Cache-hit atom DISPOSITION re-enrichment (serial; process-global mocks).
+ *
+ * The semantic result cache is hard-disabled in production
+ * (`semanticResultCacheAvailable() === false`), so the cache-HIT branch of
+ * `hybridSearchCached` cannot be reached through the real cache. This test
+ * forces the hit branch with a mocked cache module and pins the contract: a
+ * hit returns rows STORED EARLIER, so any `atom_disposition` they carry is
+ * stale — the hit path MUST re-enrich against CURRENT data before returning.
+ */
+import { afterAll, beforeAll, describe, expect, mock, test } from 'bun:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import * as realEmbedding from '../src/core/embedding.ts';
+import * as realCache from '../src/core/search/query-cache.ts';
+
+/** Deterministic 1536d unit vector — identical every call. */
+function fixedEmbedding(): Float32Array {
+  const arr = new Float32Array(1536);
+  for (let i = 0; i < 1536; i++) arr[i] = Math.sin(1 + i * 0.001);
+  let norm = 0;
+  for (let i = 0; i < 1536; i++) norm += arr[i] * arr[i];
+  norm = Math.sqrt(norm);
+  if (norm > 0) for (let i = 0; i < 1536; i++) arr[i] /= norm;
+  return arr;
+}
+
+// The stale disposition a previously-stored cache row carries.
+const STALE_DISPOSITION = {
+  status: 'STALE_FROM_CACHE',
+  explanation: 'stored at write time',
+  assessed_at: '2000-01-01T00:00:00.000Z',
+  assessment_slug: 'operations/atom-evidence-repair-20261011/assessments-9999',
+  source_id: 'default',
+  historical: true,
+  certified: false,
+  warning: { code: 'historical_not_certified', message: 'stale' },
+};
+
+// A cache row as it would have been stored at write time.
+let cachedRows: unknown[] = [];
+
+mock.module('../src/core/embedding.ts', () => ({
+  ...realEmbedding,
+  embed: async () => fixedEmbedding(),
+  embedQuery: async () => fixedEmbedding(),
+}));
+
+// Force the HIT branch: availability on, and a cache that always returns the
+// pre-stored rows (spread keeps every other real export live).
+mock.module('../src/core/search/query-cache.ts', () => ({
+  ...realCache,
+  semanticResultCacheAvailable: () => true,
+  SemanticQueryCache: class {
+    constructor() {}
+    isEnabled() { return true; }
+    async lookup() {
+      return {
+        hit: true,
+        results: cachedRows,
+        meta: { vector_enabled: true, detail_resolved: null, expansion_applied: false, degraded: [] },
+        similarity: 0.99,
+        ageSeconds: 5,
+      };
+    }
+    async store() { /* no-op */ }
+    async stats() { return {}; }
+  },
+}));
+
+const { hybridSearchCached } = await import('../src/core/search/hybrid.ts');
+const { configureGateway, resetGateway } = await import('../src/core/ai/gateway.ts');
+const { PGLiteEngine } = await import('../src/core/pglite-engine.ts');
+const { computeAtomBodySha256, ATOM_ASSESSMENT_SLUG_PREFIX } = await import('../src/core/search/atom-disposition.ts');
+
+let engine: InstanceType<typeof PGLiteEngine>;
+let tmpHome: string;
+const savedGbrainHome = process.env.GBRAIN_HOME;
+
+let atomId = 0;
+const ATOM_SLUG = 'atoms/2026-01-01/cache-000000';
+
+beforeAll(async () => {
+  tmpHome = mkdtempSync(join(tmpdir(), 'gbrain-atom-disposition-cache-'));
+  process.env.GBRAIN_HOME = tmpHome;
+
+  resetGateway();
+  configureGateway({
+    embedding_model: 'openai:text-embedding-3-large',
+    embedding_dimensions: 1536,
+    env: { OPENAI_API_KEY: 'sk-fake' },
+  });
+
+  engine = new PGLiteEngine();
+  await engine.connect({});
+  await engine.initSchema();
+
+  // Live source page + atom + a valid companion assessment.
+  await engine.putPage('guides/alpha', { type: 'article', title: 'guides/alpha', compiled_truth: 'The alpha system uses a queue.' });
+  await engine.putPage(ATOM_SLUG, {
+    type: 'atom',
+    title: ATOM_SLUG,
+    compiled_truth: 'claim body',
+    frontmatter: { type: 'atom', source_slug: 'guides/alpha', source_hash: 'deadbeefdeadbeef' },
+  });
+  const [atomRow] = await engine.executeRaw<{ id: number }>(`SELECT id FROM pages WHERE slug = $1`, [ATOM_SLUG]);
+  atomId = Number(atomRow.id);
+  await engine.putPage(`${ATOM_ASSESSMENT_SLUG_PREFIX}0001`, {
+    type: 'note',
+    title: 'assessments',
+    compiled_truth: 'companion',
+    frontmatter: {
+      atom_assessments: [{
+        atom_id: atomId,
+        atom_slug: ATOM_SLUG,
+        source_id: 'default',
+        frozen_source_hash: 'deadbeefdeadbeef',
+        frozen_source_slug: 'guides/alpha',
+        body_sha256: computeAtomBodySha256('claim body'),
+        status: 'repaired',
+        explanation: 'evidence recovered',
+        evidence_slug: 'guides/alpha',
+        assessed_at: '2026-10-11T00:00:00.000Z',
+      }],
+    },
+  });
+
+  cachedRows = [
+    {
+      slug: ATOM_SLUG, page_id: atomId, title: ATOM_SLUG, type: 'atom',
+      chunk_text: 'claim body', chunk_source: 'compiled_truth', chunk_id: 1, chunk_index: 0,
+      score: 0.9, stale: false, source_id: 'default',
+      atom_disposition: STALE_DISPOSITION,
+    },
+    {
+      slug: 'guides/alpha', page_id: 999_999, title: 'guides/alpha', type: 'article',
+      chunk_text: 'body', chunk_source: 'compiled_truth', chunk_id: 2, chunk_index: 0,
+      score: 0.5, stale: false, source_id: 'default',
+    },
+  ];
+});
+
+afterAll(async () => {
+  if (savedGbrainHome === undefined) delete process.env.GBRAIN_HOME;
+  else process.env.GBRAIN_HOME = savedGbrainHome;
+  try { await engine.disconnect(); } catch { /* ignore */ }
+  resetGateway();
+  try { rmSync(tmpHome, { recursive: true, force: true }); } catch { /* ignore */ }
+});
+
+describe('cache-hit atom_disposition re-enrichment', () => {
+  test('a cache hit re-enriches stored atom rows with CURRENT data', async () => {
+    let meta: import('../src/core/types.ts').HybridSearchMeta | undefined;
+    const results = await hybridSearchCached(engine, 'builder', {
+      limit: 10,
+      onMeta: (m) => { meta = m; },
+    });
+
+    // The hit branch really ran.
+    expect(meta?.cache?.status).toBe('hit');
+
+    const atom = results.find((r) => r.page_id === atomId)!;
+    expect(atom).toBeDefined();
+    // Fresh disposition from the companion, NOT the stale stored one.
+    expect(atom.atom_disposition?.status).toBe('repaired');
+    expect(atom.atom_disposition?.evidence_slug).toBe('guides/alpha');
+    expect(atom.atom_disposition?.warning.code).toBe('historical_not_certified');
+
+    // Non-atom rows never carry a disposition.
+    const other = results.find((r) => r.page_id === 999_999)!;
+    expect(other.atom_disposition).toBeUndefined();
+  });
+});
diff --git a/test/atom-disposition.test.ts b/test/atom-disposition.test.ts
new file mode 100644
index 0000000000..ceb517d2d6
--- /dev/null
+++ b/test/atom-disposition.test.ts
@@ -0,0 +1,176 @@
+/**
+ * Stage 3B B27 (task <task>) — read-time atom_disposition enrichment from
+ * canonical companion assessment pages.
+ *
+ * Real paths only: a disposable in-memory PGLite engine, the module's own
+ * batched loader, the public `search` op and the public `get_page` op. The
+ * companion assessment is written the way the evidence-repair pass writes it
+ * (a SEPARATE canonical `operations/atom-evidence-repair-20261011/assessments-*`
+ * note carrying a frontmatter `atom_assessments` array); the atom itself is
+ * never touched.
+ *
+ * Guarded behaviour: same-source + visibility isolation, field-exact binding
+ * against the live atom, fail-closed stale/conflict/absent handling, sanitized
+ * references, historical=true / certified=false framing, stale-clearing on the
+ * cache-hit path, and no original-atom mutation.
+ */
+import { afterAll, beforeAll, describe, expect, test } from 'bun:test';
+import { PGLiteEngine } from '../src/core/pglite-engine.ts';
+import { importFromContent } from '../src/core/import-file.ts';
+import { dispatchToolCall } from '../src/mcp/dispatch.ts';
+import { computeAtomBodySha256, stampAtomDispositions } from '../src/core/search/atom-disposition.ts';
+
+let engine: PGLiteEngine;
+
+const TOKEN = 'dispositio';
+const ASSESS_PAGE = 'operations/atom-evidence-repair-20261011/assessments-2026-01-01';
+const VALIDATED_SLUG = 'notes/evidence-page';
+
+function doc(type: string, title: string, body: string, extra: Record<string, string> = {}): string {
+  const head = ['---', `type: ${type}`, `title: ${title}`, ...Object.entries(extra).map(([k, v]) => `${k}=${v}`).map(s => s.replace('=', ': ')), '---', ''];
+  return `${head.join('\n')}\n${body}\n`;
+}
+
+async function put(slug: string, content: string, sourceId = 'default'): Promise<void> {
+  await importFromContent(engine, slug, content, { noEmbed: true, forceRechunk: true, sourceId });
+}
+
+async function pageRow(slug: string): Promise<{ id: number; body: string; sh: string | null; ss: string | null }> {
+  const rows = await engine.executeRaw<{ id: number; body: string; sh: string | null; ss: string | null }>(
+    `SELECT id, compiled_truth AS body, frontmatter->>'source_hash' AS sh, frontmatter->>'source_slug' AS ss
+       FROM pages WHERE slug = $1 AND source_id = 'default'`, [slug]);
+  return rows[0];
+}
+
+/** The evidence-repair pass writes the record array onto the companion note. */
+async function writeAssessments(records: unknown[]): Promise<void> {
+  await engine.executeRaw(
+    `UPDATE pages SET frontmatter = COALESCE(frontmatter,'{}'::jsonb) || jsonb_build_object('atom_assessments', $1::jsonb)
+      WHERE slug = $2 AND source_id = 'default'`,
+    [JSON.stringify(records), ASSESS_PAGE]);
+}
+
+/** A well-formed record bound exactly to the live atom. */
+async function recordFor(slug: string, over: Record<string, unknown> = {}): Promise<Record<string, unknown>> {
+  const row = await pageRow(slug);
+  return {
+    atom_id: Number(row.id),
+    atom_slug: slug,
+    source_id: 'default',
+    frozen_source_hash: row.sh,
+    frozen_source_slug: row.ss,
+    body_sha256: computeAtomBodySha256(row.body),
+    status: 'retained',
+    explanation: 'passage verified against the live source page',
+    assessed_at: '2026-10-11T00:00:00Z',
+    ...over,
+  };
+}
+
+beforeAll(async () => {
+  engine = new PGLiteEngine();
+  await engine.connect({});
+  await engine.initSchema();
+
+  await put('notes/live', doc('note', 'Live page', `${TOKEN} the live source body`));
+  await put('notes/evidence-page', doc('note', 'Evidence page', `${TOKEN} cited evidence`));
+  await put('notes/private-evidence', doc('note', 'Private evidence', `${TOKEN} private evidence`, { visibility: 'private' }));
+  await put('atoms/2026-01-01/assessable', doc('atom', 'Assessable atom', `${TOKEN} assessed passage`, { source_slug: 'notes/live', source_hash: 'aaaabbbbccccdddd' }));
+  await put('atoms/2026-01-01/unassessed', doc('atom', 'Unassessed atom', `${TOKEN} no companion record`, { source_slug: 'notes/live', source_hash: 'aaaabbbbccccdddd' }));
+  await put(ASSESS_PAGE, doc('note', 'Assessment companion', 'holds the atom_assessments array'));
+}, 120_000);
+
+afterAll(async () => { await engine?.disconnect(); });
+
+async function dispositionViaModule(slug: string): Promise<Record<string, unknown> | undefined> {
+  const row = await pageRow(slug);
+  const page = await engine.getPage(slug);
+  const map = await (await import('../src/core/search/atom-disposition.ts')).loadAtomDispositions(engine, [{
+    id: Number(row.id), slug, source_id: 'default', source_hash: row.sh, source_slug: row.ss,
+    body_sha256: computeAtomBodySha256(row.body),
+  }]);
+  expect(page?.slug).toBe(slug);
+  return map.get(Number(row.id)) as unknown as Record<string, unknown> | undefined;
+}
+
+describe('B27 read-time atom disposition', () => {
+  test('a field-exact, same-source assessment is surfaced as historical evidence', async () => {
+    const rec = await recordFor('atoms/2026-01-01/assessable', { evidence_slug: VALIDATED_SLUG, successor_slug: '/etc/passwd' });
+    await writeAssessments([rec]);
+    const d = await dispositionViaModule('atoms/2026-01-01/assessable');
+    expect(d?.status).toBe('retained');
+    expect(d?.historical).toBe(true);
+    expect(d?.certified).toBe(false);
+    expect((d?.warning as Record<string, unknown>)?.code).toBe('historical_not_certified');
+    expect(d?.source_id).toBe('default');
+    expect(d?.assessment_slug).toBe(ASSESS_PAGE);
+    // Sanitized references: a live same-source slug is exposed; a filesystem
+    // path shape is never exposed.
+    expect(d?.evidence_slug).toBe(VALIDATED_SLUG);
+    expect(d?.successor_slug).toBeUndefined();
+  });
+
+  test('a stale binding fails closed', async () => {
+    const rec = await recordFor('atoms/2026-01-01/assessable');
+    await writeAssessments([rec]);
+    // The atom changes after it was assessed → the frozen body hash no longer matches.
+    await put('atoms/2026-01-01/assessable', doc('atom', 'Assessable atom', `${TOKEN} assessed passage REWRITTEN`, { source_slug: 'notes/live', source_hash: 'aaaabbbbccccdddd' }));
+    const d = await dispositionViaModule('atoms/2026-01-01/assessable');
+    expect(d?.status).toBe('untrusted');
+    expect((d?.warning as Record<string, unknown>)?.code).toBe('assessment_stale');
+    expect(d?.certified).toBe(false);
+  });
+
+  test('disagreeing records fail closed and an unassessed atom stays absent', async () => {
+    const a = await recordFor('atoms/2026-01-01/assessable', { status: 'retained' });
+    const b = await recordFor('atoms/2026-01-01/assessable', { status: 'superseded', assessed_at: '2026-10-12T00:00:00Z' });
+    await writeAssessments([a, b]);
+    const d = await dispositionViaModule('atoms/2026-01-01/assessable');
+    expect(d?.status).toBe('untrusted');
+    expect((d?.warning as Record<string, unknown>)?.code).toBe('assessment_conflict');
+    expect(await dispositionViaModule('atoms/2026-01-01/unassessed')).toBeUndefined();
+  });
+
+  test('the stamp clears a stale disposition before re-enriching (cache-hit path)', async () => {
+    await writeAssessments([]);           // no companion record any more
+    const rows = [{ page_id: (await pageRow('atoms/2026-01-01/assessable')).id, type: 'atom', slug: 'atoms/2026-01-01/assessable', atom_disposition: { status: 'stale-cached' } }] as never[];
+    await stampAtomDispositions(engine, rows as never);
+    expect((rows[0] as Record<string, unknown>).atom_disposition).toBeUndefined();
+  });
+});
+
+describe('B27 enrichment on the public read paths', () => {
+  test('get_page and search both surface the validated disposition', async () => {
+    const rec = await recordFor('atoms/2026-01-01/assessable', { evidence_slug: VALIDATED_SLUG });
+    await writeAssessments([rec]);
+
+    const got = await dispatchToolCall(engine, 'get_page', { slug: 'atoms/2026-01-01/assessable' }, { remote: false, transport: 'http', sourceId: 'default' });
+    const page = JSON.parse(got.content[0]?.text ?? '{}') as { atom_disposition?: Record<string, unknown> };
+    expect(page.atom_disposition?.status).toBe('retained');
+    expect(page.atom_disposition?.historical).toBe(true);
+
+    const found = await dispatchToolCall(engine, 'search', { query: TOKEN, limit: 50, include_covered_atoms: true }, { remote: false, transport: 'http', sourceId: 'default' });
+    const rows = JSON.parse(found.content[0]?.text ?? '[]') as Array<{ slug: string; atom_disposition?: Record<string, unknown> }>;
+    const atom = rows.find(r => r.slug === 'atoms/2026-01-01/assessable');
+    expect(atom?.atom_disposition?.status).toBe('retained');
+    expect(atom?.atom_disposition?.certified).toBe(false);
+    // The original atom body and its frozen provenance are untouched.
+    const row = await pageRow('atoms/2026-01-01/assessable');
+    expect(row.body).toContain('REWRITTEN');
+    expect(row.ss).toBe('notes/live');
+  });
+
+  test('the direct keyword path (match: keyword) also carries the disposition', async () => {
+    const rec = await recordFor('atoms/2026-01-01/assessable', { evidence_slug: VALIDATED_SLUG });
+    await writeAssessments([rec]);
+
+    // `match: keyword` takes the op's direct-FTS path (its own stampKeywordRows
+    // tail), a different route from the hybrid arms above.
+    const found = await dispatchToolCall(engine, 'search', { query: TOKEN, limit: 50, match: 'keyword', include_covered_atoms: true }, { remote: false, transport: 'http', sourceId: 'default' });
+    const rows = JSON.parse(found.content[0]?.text ?? '[]') as Array<{ slug: string; atom_disposition?: Record<string, unknown> }>;
+    const atom = rows.find(r => r.slug === 'atoms/2026-01-01/assessable');
+    expect(atom?.atom_disposition?.status).toBe('retained');
